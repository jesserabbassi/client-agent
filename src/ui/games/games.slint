import { Activity } from "../shared/activity.slint";
import { Theme, Panel, Eyebrow, ActionButton } from "../shared/design.slint";
export component Games inherits Rectangle {
    private property <string> category: "All Games";
    background: Theme.background;
    min-height: 850px;
    VerticalLayout { width: min(root.width, 1320px); x: (root.width - self.width) / 2; alignment: start; padding: 32px; spacing: 18px;
        Eyebrow { text: "FIND YOUR NEXT OBSESSION"; color: Theme.accent; }
        Text { text: "The games library."; color: Theme.text; font-size: 32px; font-weight: 700; height: 42px; }
        Text { text: Activity.session-active ? Activity.session-label + " · Choose a game to make it yours." : "From the first round to the final whistle. Start a session to choose a game."; color: Theme.muted; font-size: 13px; wrap: word-wrap; height: 32px; }
        if Activity.message != "": Text { text: Activity.message; color: Theme.accent; font-size: 12px; wrap: word-wrap; min-height: 28px; }
        HorizontalLayout { spacing: 8px; height: 40px;
            for label in ["All Games", "FPS", "MOBA", "Sports", "Racing"]: ActionButton {
                text: label; primary: root.category == label; min-width: 85px; clicked => { root.category = label; }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }
        VerticalLayout { spacing: 16px;
            for row in [
                [{ name: "Counter-Strike 2", genre: "FPS", mark: "CS / 2", subtitle: "EVERY ROUND COUNTS", accent: #bf8950 }, { name: "Valorant", genre: "FPS", mark: "V /", subtitle: "DEFY THE LIMITS", accent: #d76078 }, { name: "League of Legends", genre: "MOBA", mark: "L / L", subtitle: "OWN THE RIFT", accent: #4ea9b0 }],
                [{ name: "Dota 2", genre: "MOBA", mark: "D / 2", subtitle: "MAKE YOUR LEGEND", accent: #bd6553 }, { name: "EA FC 24", genre: "Sports", mark: "FC /", subtitle: "FOR THE LOVE OF FOOTBALL", accent: #80a676 }, { name: "Rocket League", genre: "Racing", mark: "R / L", subtitle: "TAKE TO THE SKY", accent: #729ee6 }]
            ]: HorizontalLayout { spacing: 16px; height: 254px;
                for game in row: Panel {
                    opacity: root.category == "All Games" || root.category == game.genre ? 1 : 0.3;
                    border-color: Activity.selected-game == game.name ? Theme.cyan : Theme.border;
                    VerticalLayout { padding: 12px; spacing: 10px;
                        Rectangle { height: 118px; border-radius: 7px; clip: true; background: @linear-gradient(135deg, game.accent.darker(45%), #141d2a);
                            for i in 5: Rectangle { x: parent.width * 0.52 + i * 19px; y: -12px; width: 1px; height: 155px; background: game.accent; opacity: 0.25; }
                            Text { x: 16px; y: 18px; text: game.mark; color: #ffffff; font-size: 37px; font-weight: 900; }
                            Text { x: 16px; y: 89px; text: game.subtitle; color: game.accent.brighter(40%); font-size: 8px; font-weight: 600; }
                        }
                        HorizontalLayout { height: 30px; spacing: 4px;
                            Text { text: game.name; color: Theme.text; font-size: 14px; font-weight: 600; wrap: word-wrap; vertical-alignment: center; }
                            Text { text: game.genre; color: Theme.subtle; font-size: 9px; horizontal-alignment: right; width: 40px; vertical-alignment: center; }
                        }
                        ActionButton {
                            text: Activity.selected-game == game.name ? "Launch again  ↗" : "Launch game  →";
                            height: 40px;
                            primary: Activity.selected-game == game.name;
                            enabled: Activity.session-active && (root.category == "All Games" || root.category == game.genre);
                            clicked => { Activity.choose-game(game.name); }
                        }
                    }
                }
            }
        }
        Panel { min-height: 125px; background: #152429; border-color: #2b4447;
            HorizontalLayout { padding: 22px; spacing: 20px;
                VerticalLayout { spacing: 9px;
                    Eyebrow { text: "YOUR LINEUP"; color: Theme.cyan; }
                    Text { text: Activity.selected-game == "" ? "Good games are better together." : "Up next: " + Activity.selected-game; color: Theme.text; font-size: 19px; font-weight: 600; wrap: word-wrap; }
                    Text { text: Activity.message; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
                    Text { text: "The game must be installed on this computer."; color: Theme.subtle; font-size: 10px; }
                }
                if Activity.session-active: ActionButton { text: "End session"; width: 125px; height: 42px; clicked => { Activity.end(); } }
            }
        }
    }
}
