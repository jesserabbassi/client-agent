export { Activity, Reservation, Transaction } from "shared/activity.slint";
import { OtpScreen } from "otp/otp.slint";
import { LoginScreen } from "login/screen.slint";
import { RegistrationScreen, RegistrationState } from "registration/registration.slint";
import { AppShell, Page } from "shell.slint";
import { CompactSession } from "compact/compact.slint";
import { Palette } from "std-widgets.slint";
export { Page }
export { RegistrationState }
export component ClientView inherits Window {
    title: root.compact-mode ? "Ninety Agent" : "Ninety Gaming House — Gaming Client";
    preferred-width: 1280px;
    preferred-height: 880px;
    min-width: root.compact-mode ? root.compact-width * 1px : 1120px;
    max-width: root.compact-mode ? root.compact-width * 1px : 10000px;
    min-height: root.compact-mode ? 820px : 830px;
    max-height: root.compact-mode ? 820px : 10000px;
    background: #0b1019;
    default-font-family: "Arial";
    default-font-size: 14px;
    init => { Palette.color-scheme = ColorScheme.dark; }
    in property <bool> busy: false;
    in property <bool> authenticated: false;
    in-out property <bool> setup-complete: false;
    in property <RegistrationState> registration-state: RegistrationState.initial;
    in-out property <string> station-id;
    in property <string> machine-name;
    in property <string> agent-version;
    in-out property <bool> compact-mode: false;
    in-out property <float> compact-width: 150;
    in-out property <int> full-window-x: 0;
    in-out property <int> full-window-y: 0;
    in-out property <int> full-window-width: 1280;
    in-out property <int> full-window-height: 880;
    in property <bool> development-mode: true;
    in property <bool> connection-problem: false;
    in property <string> status-text;
    in property <string> message;
    in-out property <string> password;
    in property <string> player-name;
    in property <Page> page: Page.dashboard;
    in property <bool> otp-pending: false;
    in-out property <string> otp-code;
    in-out property <string> otp-user-id;
    in property <string> otp-error;
    in property <int> otp-attempts: 0;
    callback otp-verify();
    callback otp-cancel();
    callback navigate(Page);
    callback logout-requested();
    callback login-requested(string, string, bool);
    callback register-requested(string, string, string);
    callback station-registration-requested(string);
    callback open-full-agent();
    if !root.setup-complete: RegistrationScreen {
        state: root.registration-state;
        station-id <=> root.station-id;
        machine-name: root.machine-name;
        agent-version: root.agent-version;
        message: root.message;
        register(id) => { root.station-registration-requested(id); }
        retry => { root.station-registration-requested(root.station-id); }
    }
    if root.setup-complete && !root.authenticated && !root.otp-pending: LoginScreen {
        busy: root.busy;
        authenticated: root.authenticated;
        development-mode: root.development-mode;
        connection-problem: root.connection-problem;
        status-text: root.status-text;
        message: root.message;
        password <=> root.password;
        login-requested(u, p, r) => { root.login-requested(u, p, r); }
        register-requested(e, p, c) => { root.register-requested(e, p, c); }
    }
    if root.setup-complete && !root.authenticated && root.otp-pending: OtpScreen {
        code <=> root.otp-code;
        error: root.otp-error;
        locked: root.otp-attempts >= 5;
        demo: root.development-mode;
        verify => { root.otp-verify(); }
        cancel => { root.otp-cancel(); }
    }
    if root.authenticated && !root.compact-mode: AppShell {
        player-name: root.player-name;
        page: root.page;
        navigate(page) => { root.navigate(page); }
        logout => { root.logout-requested(); }
    }
    if root.authenticated && root.compact-mode: CompactSession {
        player-name: root.player-name;
        open-full-agent => { root.open-full-agent(); }
    }
}
