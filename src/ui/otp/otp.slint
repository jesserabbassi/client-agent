import { Theme, ActionButton } from "../shared/design.slint";
import { LineEdit } from "std-widgets.slint";
export component OtpScreen inherits Rectangle {
    in-out property <string> code;
    in property <string> error;
    in property <bool> locked;
    in property <bool> demo;
    callback verify();
    callback cancel();
    background: @linear-gradient(120deg, #0b1019, #17252c, #0b1019);
    VerticalLayout { alignment: center; spacing: 22px;
        Text { text: "NINETY"; color: white; font-size: 34px; font-weight: 900; horizontal-alignment: center; height: 45px; }
        Text { text: "G A M I N G   H O U S E"; color: #91acbf; font-size: 11px; horizontal-alignment: center; height: 20px; }
        HorizontalLayout { alignment: center;
            Rectangle { width: 490px; height: 550px; background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 16px;
                VerticalLayout { padding: 36px; spacing: 18px;
                    Text { text: "ONE MORE STEP"; color: Theme.accent; font-size: 12px; height: 20px; }
                    Text { text: "You’re almost in."; color: white; font-size: 30px; font-weight: 700; height: 42px; }
                    Text { text: "Enter your six-digit verification code\nto continue to your gaming dashboard."; color: Theme.muted; font-size: 15px; height: 50px; }
                    Text { text: "A verification code was sent to your account."; color: Theme.cyan; font-size: 12px; wrap: word-wrap; height: 35px; }
                    editor := LineEdit { text <=> root.code; placeholder-text: "6-digit code"; enabled: !root.locked; font-size: 24px; height: 55px; accepted => { root.verify(); } }
                    Text { text: root.error; color: #ff9b80; wrap: word-wrap; height: 45px; font-size: 13px; }
                    ActionButton { text: "Verify & continue →"; primary: true; enabled: !root.locked; height: 48px; clicked => { root.verify(); } }
                    ActionButton { text: "← Back to login"; height: 40px; clicked => { root.cancel(); } }
                }
            }
        }
    }
}
