import { Button, ScrollView } from "std-widgets.slint";

component Panel inherits Rectangle {
    background: #041b28;
    border-width: 1px;
    border-color: #154257;
    border-radius: 7px;
    @children
}
component Stat inherits Panel {
    in property <string> value;
    in property <string> label;
    in property <string> symbol;
    in property <color> accent;
    height: 118px;
    HorizontalLayout { padding: 18px; spacing: 15px;
        Text { text: root.symbol; color: root.accent; font-size: 20px; vertical-alignment: center; horizontal-stretch: 0; }
        VerticalLayout { alignment: center; spacing: 8px;
            Text { text: root.value; color: #f4f7fc; font-size: 27px; font-weight: 700; }
            Text { text: root.label; color: #a5bac9; font-size: 12px; wrap: word-wrap; }
        }
    }
}
component SectionTitle inherits Text {
    color: #f4f7fc;
    font-size: 19px;
    font-weight: 600;
    height: 30px;
}
export component Dashboard inherits Rectangle {
    in property <string> player-name;
    callback logout-requested();
    callback stations-requested();
    background: #00121d;
    VerticalLayout { spacing: 0px;
        Rectangle { height: 78px; background: #031520;
            HorizontalLayout { padding-left: 25px; padding-right: 25px; spacing: 24px;
                VerticalLayout { width: 195px; alignment: center; spacing: 3px;
                    Text { text: "NINETY"; font-size: 29px; font-weight: 900; color: white; }
                    Text { text: "G A M I N G   H O U S E"; font-size: 9px; color: #a6bdce; }
                }
                Text { vertical-alignment: center; text: "YOUR GAMING HQ"; color: #628499; font-size: 12px; }
                Text { vertical-alignment: center; text: "Downtown Branch"; color: #cbd9e3; horizontal-alignment: right; }
                Text { vertical-alignment: center; text: "●  DEMO"; color: #00dfb1; horizontal-stretch: 0; }
                Text { vertical-alignment: center; text: root.player-name; color: white; font-weight: 600; horizontal-stretch: 0; }
                Button { height: 38px; width: 95px; text: "Log out"; clicked => { root.logout-requested(); } }
            }
        }
        Rectangle { height: 1px; background: #123344; }
        HorizontalLayout { spacing: 0px;
            Rectangle { width: 205px; background: @linear-gradient(160deg, #051c2a, #00101b);
                VerticalLayout { padding-top: 24px; padding-bottom: 28px; spacing: 6px;
                    Rectangle { height: 52px; background: @linear-gradient(90deg, #592915, #101d26);
                        Rectangle { x: 0px; y: 0px; width: 4px; height: parent.height; background: #ff591e; }
                        Text { x: 25px; width: parent.width - 25px; height: parent.height; text: "Dashboard"; color: #ffac36; font-size: 15px; vertical-alignment: center; }
                    }
                    Button { text: "Available Stations"; height: 49px; clicked => { root.stations-requested(); } }
                    for label in ["My Reservations", "Games", "Wallet & Payments", "Messages", "Settings"]: Rectangle {
                        height: 49px; background: transparent;
                        VerticalLayout { padding-left: 25px; alignment: center; spacing: 3px;
                            Text { text: label; color: #758d9d; font-size: 14px; }
                            Text { text: "COMING NEXT"; color: #496272; font-size: 8px; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text { x: 25px; text: "MORE\nTHAN A\nGAME"; color: white; font-size: 20px; height: 90px; }
                    Rectangle { x: 25px; width: 42px; height: 4px; background: #ff591e; }
                }
            }
            ScrollView {
                viewport-width: self.width;
                VerticalLayout { padding: 25px; spacing: 18px;
                    HorizontalLayout { height: 63px;
                        VerticalLayout { spacing: 6px;
                            Text { text: "Welcome back, " + root.player-name + "!"; color: white; font-size: 29px; font-weight: 700; }
                            Text { text: "Ready for your next gaming session?"; color: #a5bac9; font-size: 16px; }
                        }
                        Text { text: "SAMPLE DATA\nPreview your gaming home"; color: #678ea5; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; }
                    }
                    HorizontalLayout { spacing: 12px;
                        Stat { symbol: "01"; value: "2"; label: "Upcoming reservations"; accent: #00dfb1; }
                        Stat { symbol: "02"; value: "12h"; label: "Total playtime"; accent: #12bafa; }
                        Stat { symbol: "03"; value: "5"; label: "Games played"; accent: #ff9e20; }
                        Stat { symbol: "04"; value: "48.50 €"; label: "Wallet balance"; accent: #c86cff; }
                    }
                    HorizontalLayout { spacing: 16px;
                        Panel { horizontal-stretch: 2; height: 230px;
                            background: @linear-gradient(110deg, #713313, #101e2a, #061524);
                            VerticalLayout { padding: 26px; spacing: 10px;
                                Text { text: "THE NEXT ROUND IS YOURS"; color: #ffaa37; font-size: 11px; font-weight: 700; }
                                Text { text: "PLAY. COMPETE. BELONG."; color: white; font-size: 28px; font-weight: 800; wrap: word-wrap; }
                                Text { text: "Your station. Your squad. Your home for gaming."; color: #d0d9e2; font-size: 14px; wrap: word-wrap; }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                Button { text: "Browse available stations →"; clicked => { root.stations-requested(); } }
                            }
                        }
                        Panel { horizontal-stretch: 1; height: 230px;
                            VerticalLayout { padding: 18px; spacing: 9px;
                                SectionTitle { text: "Station Availability"; }
                                Text { text: "32  total PCs"; color: white; font-size: 26px; font-weight: 700; }
                                HorizontalLayout { height: 9px; spacing: 3px;
                                    Rectangle { horizontal-stretch: 24; background: #00d5a4; border-radius: 3px; }
                                    Rectangle { horizontal-stretch: 4; background: #20a8f4; }
                                    Rectangle { horizontal-stretch: 2; background: #ffa126; }
                                    Rectangle { horizontal-stretch: 2; background: #ff5262; border-radius: 3px; }
                                }
                                Text { text: "●  24 available       ●  4 in use"; color: #00d5a4; font-size: 13px; }
                                Text { text: "2 maintenance  ·  2 offline"; color: #a5bac9; font-size: 13px; }
                            }
                        }
                    }
                    HorizontalLayout { spacing: 16px;
                        Panel { horizontal-stretch: 2; height: 230px;
                            VerticalLayout { padding: 18px; spacing: 12px;
                                SectionTitle { text: "My Upcoming Reservations"; }
                                for booking in [
                                    { game: "Counter-Strike 2", station: "PC-03  ·  Today  ·  16:00 – 20:00", status: "Confirmed", accent: #00d5a4 },
                                    { game: "Valorant", station: "PC-07  ·  Tomorrow  ·  14:00 – 17:00", status: "Pending", accent: #ffa126 }
                                ]: Rectangle { background: #082333; border-radius: 5px;
                                    HorizontalLayout { padding: 12px; spacing: 10px;
                                        Rectangle { width: 4px; background: booking.accent; border-radius: 2px; }
                                        VerticalLayout { spacing: 6px; alignment: center;
                                            Text { text: booking.game; color: white; font-size: 15px; }
                                            Text { text: booking.station; color: #97b2c4; font-size: 12px; wrap: word-wrap; }
                                        }
                                        Text { text: booking.status; color: booking.accent; font-size: 11px; vertical-alignment: center; horizontal-stretch: 0; }
                                    }
                                }
                            }
                        }
                        Panel { horizontal-stretch: 1; height: 230px;
                            VerticalLayout { padding: 18px; spacing: 12px;
                                SectionTitle { text: "Recent Activity"; }
                                for activity in ["Reservation confirmed · PC-03", "Wallet top up · +20.00 €", "Played Valorant · 3h 20m", "Profile updated"]: Text {
                                    text: activity; color: #a5bac9; font-size: 13px; wrap: word-wrap;
                                }
                            }
                        }
                    }
                    Panel { height: 112px;
                        VerticalLayout { padding: 18px; spacing: 12px;
                            SectionTitle { text: "Popular Games"; }
                            HorizontalLayout { spacing: 10px;
                                for game in ["Counter-Strike 2", "Valorant", "League of Legends", "Fortnite", "EA FC 24"]: Rectangle {
                                    background: @linear-gradient(110deg, #103647, #19283e); border-radius: 4px;
                                    Text { text: game; color: #d8e6ee; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { height: 40px; background: #02101a;
            Text { x: 25px; text: "NINETY GAMING HOUSE    |    ESPORTS    |    COMMUNITY    |    PREMIUM EXPERIENCE"; color: #7390a4; font-size: 9px; vertical-alignment: center; }
        }
    }
}
