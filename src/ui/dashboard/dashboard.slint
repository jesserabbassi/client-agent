import { Button } from "std-widgets.slint";
export component Dashboard inherits Rectangle {
    in property <string> player-name;
    callback games();
    callback wallet();
    background: #00121d;
    min-height: 690px;
    VerticalLayout { padding: 26px; spacing: 20px;
        Text { text: "Welcome back, " + root.player-name + "!"; color: white; font-size: 30px; font-weight: 700; height: 42px; }
        Text { text: "Your games. Your wallet. Your gaming home.  ·  Sample data"; color: #9fb8c9; height: 25px; }
        HorizontalLayout { spacing: 14px; height: 115px;
            for stat in [
                { value: "12h", label: "Total playtime", accent: #13b6ff },
                { value: "5", label: "Games played", accent: #ff9c28 },
                { value: "48.50 €", label: "Wallet balance", accent: #c76aff }
            ]: Rectangle { background: #061d2c; border-width: 1px; border-color: stat.accent; border-radius: 7px;
                VerticalLayout { padding: 22px; spacing: 10px;
                    Text { text: stat.value; color: white; font-size: 29px; font-weight: 700; }
                    Text { text: stat.label; color: #9fb8c9; }
                }
            }
        }
        HorizontalLayout { spacing: 18px; height: 220px;
            Rectangle { horizontal-stretch: 2; background: @linear-gradient(115deg, #753511, #102031, #061622); border-radius: 7px;
                VerticalLayout { padding: 26px; spacing: 14px;
                    Text { text: "GAME OF THE WEEK"; color: #ffab37; font-size: 12px; }
                    Text { text: "Counter-Strike 2"; color: white; font-size: 32px; font-weight: 800; }
                    Text { text: "Competitive. Strategic. Unstoppable."; color: #b9cbd8; }
                    Button { text: "Browse games →"; clicked => { root.games(); } }
                }
            }
            Rectangle { background: #041b28; border-width: 1px; border-color: #154257; border-radius: 7px;
                VerticalLayout { padding: 20px; spacing: 16px;
                    Text { text: "Quick Actions"; color: white; font-size: 22px; }
                    Button { text: "Games library"; clicked => { root.games(); } }
                    Button { text: "View wallet"; clicked => { root.wallet(); } }
                }
            }
        }
        HorizontalLayout { spacing: 18px; height: 190px;
            Rectangle { background: #041b28; border-width: 1px; border-color: #154257; border-radius: 7px;
                VerticalLayout { padding: 20px; spacing: 16px;
                    Text { text: "Popular Games"; color: white; font-size: 22px; }
                    Text { text: "Counter-Strike 2   ·   Valorant\nLeague of Legends   ·   Fortnite"; color: #a5bac9; font-size: 15px; }
                    Button { text: "View all games →"; clicked => { root.games(); } }
                }
            }
            Rectangle { background: #041b28; border-width: 1px; border-color: #154257; border-radius: 7px;
                VerticalLayout { padding: 20px; spacing: 15px;
                    Text { text: "Recent Activity"; color: white; font-size: 22px; }
                    Text { text: "Wallet top up    +20.00 €"; color: #00dab0; }
                    Text { text: "Played Valorant    3h 20m"; color: #a5bac9; }
                    Text { text: "Played Counter-Strike 2    2h"; color: #a5bac9; }
                }
            }
        }
    }
}
