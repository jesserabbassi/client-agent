import { Button, LineEdit } from "std-widgets.slint";
import { Activity } from "../shared/activity.slint";
export component Wallet inherits Rectangle {
    background: #00121d;
    min-height: 690px;
    VerticalLayout { padding: 26px; spacing: 20px;
        Text { text: "Wallet"; color: white; font-size: 30px; font-weight: 700; height: 42px; }
        Text { text: "Your funds, your playtime. All transactions in one place."; color: #9fb8c9; height: 25px; }
        Rectangle { height: 140px; background: @linear-gradient(120deg, #66378a, #051925); border-radius: 8px;
            VerticalLayout { padding: 24px; spacing: 12px;
                Text { text: "AVAILABLE BALANCE"; color: #c1d5e2; }
                Text { text: Activity.balance; color: white; font-size: 38px; font-weight: 700; }
            }
        }
        Rectangle { height: 180px; background: #041b28; border-radius: 8px;
            VerticalLayout { padding: 22px; spacing: 12px;
                Text { text: "Add money"; color: white; font-size: 22px; }
                Text { text: "Demo top-up · No payment is taken · Enter 1.00–500.00 €"; color: #9fb8c9; }
                HorizontalLayout { spacing: 12px;
                    amount := LineEdit { placeholder-text: "Amount in EUR, e.g. 20.00"; accepted => { Activity.top-up(self.text); } }
                    Button { text: "Add demo funds"; primary: true; clicked => { Activity.top-up(amount.text); } }
                }
            }
        }
        Text { text: Activity.message; color: #54cced; wrap: word-wrap; min-height: 30px; }
        Text { text: "Transaction history"; color: white; font-size: 23px; height: 35px; }
        if Activity.transactions.length == 0: Text { text: "No transactions yet. Add demo funds to start playing."; color: #9fb8c9; height: 50px; }
        for row in Activity.transactions: Rectangle { height: 58px; background: #082332; border-radius: 4px;
            HorizontalLayout { padding: 16px; spacing: 12px;
                Text { text: row.reference; color: #7395ac; vertical-alignment: center; }
                Text { text: row.description; color: white; vertical-alignment: center; }
                Text { text: row.amount; color: #54cced; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
    }
}
