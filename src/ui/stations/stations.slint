import { Button, ScrollView } from "std-widgets.slint";

export struct StationItem {
    name: string,
    status: string,
    available: bool,
    gpu: string,
    cpu: string,
    memory: string,
    monitor: string,
    storage: string,
    rate: string,
    rate-cents: int,
}

component Rig inherits Rectangle {
    in property <color> accent: #16b7ff;
    background: @linear-gradient(130deg, #06121f, #152448, #101729);
    border-radius: 5px;
    Rectangle { x: parent.width * 0.1; y: 15px; width: parent.width * 0.52; height: parent.height - 40px;
        border-width: 2px; border-color: root.accent; border-radius: 4px; background: #061424;
        Rectangle { x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px; background: @linear-gradient(35deg, #092031, root.accent); opacity: 0.6; }
    }
    Rectangle { x: parent.width * 0.33; y: parent.height - 25px; width: 5px; height: 12px; background: #59758b; }
    Rectangle { x: parent.width * 0.22; y: parent.height - 14px; width: parent.width * 0.25; height: 3px; background: #59758b; }
    Rectangle { x: parent.width * 0.7; y: 10px; width: parent.width * 0.22; height: parent.height - 22px; background: #04101e; border-width: 1px; border-color: root.accent; border-radius: 4px;
        VerticalLayout { padding: 8px; spacing: 6px;
            for n in 3: Rectangle { border-radius: 30px; border-width: 2px; border-color: root.accent; background: #10233a; }
        }
    }
}
component Card inherits Rectangle {
    in property <StationItem> station;
    in property <bool> selected;
    callback select();
    background: #041b28;
    border-width: selected ? 2px : 1px;
    border-color: selected ? #ff6426 : #154257;
    border-radius: 7px;
    VerticalLayout { padding: 14px; spacing: 9px;
        Text { text: root.station.name; color: white; font-size: 20px; font-weight: 700; }
        Text { text: "●  " + root.station.status; color: root.station.available ? #00dab0 : root.station.status == "Offline" ? #ff586c : root.station.status == "Occupied" ? #22b9ff : #ffaa24; font-size: 13px; }
        Rig { height: 105px; accent: root.station.available ? #16b7ff : #9565cc; }
        Text { text: root.station.gpu + "  ·  " + root.station.memory; color: #c4d6e4; font-size: 12px; }
        Text { text: root.station.monitor + " monitor"; color: #91acbf; font-size: 12px; }
        Button { text: root.selected ? "Selected ✓" : root.station.available ? "Select station" : root.station.status; enabled: root.station.available; clicked => { root.select(); } }
    }
}
export component Stations inherits Rectangle {
    in property <[StationItem]> stations;
    in property <int> selected: -1;
    in property <StationItem> detail;
    callback select(int);
    callback back();
    callback book();
    callback logout();
    background: #00121d;
    VerticalLayout { spacing: 0px;
        Rectangle { height: 78px; background: #031520;
            HorizontalLayout { padding: 20px; spacing: 24px;
                Text { text: "NINETY"; color: white; font-size: 27px; font-weight: 900; vertical-alignment: center; }
                Text { text: "Downtown Branch  /  Available Stations"; color: #a5bac9; vertical-alignment: center; }
                Text { text: "●  DEMO"; color: #00dfb1; vertical-alignment: center; horizontal-stretch: 0; }
                Button { text: "Log out"; clicked => { root.logout(); } }
            }
        }
        HorizontalLayout { padding: 24px; spacing: 20px;
            VerticalLayout { spacing: 16px;
                HorizontalLayout { height: 40px;
                    Button { text: "← Dashboard"; horizontal-stretch: 0; clicked => { root.back(); } }
                    Text { text: "SAMPLE DATA"; color: #678ea5; horizontal-alignment: right; vertical-alignment: center; }
                }
                Text { text: "Choose your gaming station"; color: white; font-size: 28px; font-weight: 700; height: 36px; }
                Text { text: "Find your setup. Select an available PC to explore its hardware."; color: #a5bac9; height: 24px; }
                ScrollView {
                    viewport-width: self.width;
                    property <int> columns: self.width >= 950px ? 4 : 3;
                    viewport-height: ceil(root.stations.length / self.columns) * 294px;
                    for station[index] in root.stations: Card {
                        x: mod(index, parent.columns) * (parent.width / parent.columns);
                        y: floor(index / parent.columns) * 294px;
                        width: parent.width / parent.columns - 12px;
                        height: 280px;
                        station: station;
                        selected: root.selected == index;
                        select => { root.select(index); }
                    }
                }
            }
            Rectangle { width: 290px; background: #041b28; border-width: 1px; border-color: #154257; border-radius: 7px;
                VerticalLayout { padding: 20px; spacing: 15px;
                    Text { text: "Station Details"; color: white; font-size: 22px; font-weight: 600; height: 35px; }
                    Rig { height: 115px; accent: #a66bff; }
                    Text { text: root.selected < 0 ? "Your next arena" : root.detail.name; color: white; font-size: 27px; font-weight: 700; height: 35px; }
                    Text { text: root.selected < 0 ? "Select an available station to see its specifications." : "●  Available"; color: root.selected < 0 ? #a5bac9 : #00dab0; wrap: word-wrap; height: 44px; }
                    if root.selected >= 0: VerticalLayout { spacing: 10px;
                        for spec in [
                            "Graphics   /   " + root.detail.gpu,
                            "Processor   /   " + root.detail.cpu,
                            "Memory   /   " + root.detail.memory,
                            "Monitor   /   " + root.detail.monitor,
                            "Storage   /   " + root.detail.storage
                        ]: Text { text: spec; color: #c4d6e4; font-size: 13px; height: 26px; }
                        Rectangle { height: 1px; background: #154257; }
                        Text { text: root.detail.rate; color: #ff9a40; font-size: 22px; font-weight: 700; height: 35px; }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Button { text: "Choose date & time →"; enabled: root.selected >= 0; height: 42px; clicked => { root.book(); } }
                }
            }
        }
    }
}
