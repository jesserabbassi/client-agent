import { Button } from "std-widgets.slint";
export component Confirmation inherits Rectangle {
    in property <string> reference;
    in property <string> station;
    in property <string> summary;
    in property <string> total;
    callback back();
    callback dashboard();
    callback logout();
    background: #00121d;
    VerticalLayout { padding: 32px; spacing: 24px;
        HorizontalLayout { height: 45px;
            Text { text: "NINETY"; color: white; font-size: 28px; font-weight: 900; }
            Text { text: "DEMO BOOKING"; color: #00dab0; vertical-alignment: center; horizontal-alignment: right; }
            Button { text: "Log out"; horizontal-stretch: 0; clicked => { root.logout(); } }
        }
        Text { text: "Demo booking complete"; color: white; font-size: 32px; font-weight: 700; height: 45px; }
        Text { text: "Your booking flow is ready to preview."; color: #a5bac9; height: 25px; }
        Rectangle { background: #041b28; border-width: 1px; border-color: #154257; border-radius: 8px;
            VerticalLayout { padding: 36px; spacing: 22px; alignment: center;
                Text { text: "✓"; color: #00dab0; font-size: 72px; horizontal-alignment: center; height: 90px; }
                Text { text: root.station + "  /  Downtown Branch"; color: white; font-size: 26px; font-weight: 600; horizontal-alignment: center; height: 40px; }
                Text { text: root.summary; color: #c4d6e4; font-size: 18px; horizontal-alignment: center; height: 85px; }
                Text { text: "Estimated total   " + root.total; color: #ff9a40; font-size: 26px; horizontal-alignment: center; height: 40px; }
                Text { text: "PREVIEW REFERENCE\n" + root.reference; color: #00dab0; font-size: 14px; horizontal-alignment: center; height: 50px; }
                Text { text: "Simulation only: no payment, no reserved station, and no confirmation email.\nThis preview is cleared when you leave this flow or log out."; color: #91acbf; font-size: 14px; horizontal-alignment: center; height: 50px; }
                HorizontalLayout { spacing: 20px; height: 46px;
                    Button { text: "Browse stations"; clicked => { root.back(); } }
                    Button { text: "Back to dashboard"; clicked => { root.dashboard(); } }
                }
            }
        }
    }
}
