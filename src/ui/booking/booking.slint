import { Confirmation } from "confirmation.slint";
import { Button, LineEdit, ComboBox } from "std-widgets.slint";
export component Booking inherits Rectangle {
    private property <string> chosen-date;
    private property <int> chosen-start: 14;
    private property <int> chosen-end-index: 17;
    in property <string> reference;
    callback confirm(string, int, int);
    callback dashboard();
    in property <string> station;
    in property <string> rate;
    in property <string> total;
    in property <string> summary;
    in property <string> error;
    callback back();
    callback logout();
    callback changed();
    callback review(string, int, int);
    background: #00121d;
    if root.reference == "": VerticalLayout { padding: 28px; spacing: 24px;
        HorizontalLayout { height: 45px;
            Text { text: "NINETY"; color: white; font-size: 28px; font-weight: 900; }
            Text { text: "DOWNTOWN BRANCH  /  DEMO"; color: #00dab0; horizontal-alignment: right; vertical-alignment: center; }
            Button { text: "Log out"; horizontal-stretch: 0; clicked => { root.logout(); } }
        }
        HorizontalLayout { height: 38px;
            Button { text: "← Change station"; horizontal-stretch: 0; clicked => { root.back(); } }
            Text { text: "1  Station   /   2  Date & Time   /   3  Review"; color: #ffa14a; horizontal-alignment: right; vertical-alignment: center; }
        }
        Text { text: "Plan your next session"; color: white; font-size: 32px; font-weight: 700; height: 45px; }
        Text { text: "Choose a date and whole-hour time slot. All preview times are UTC."; color: #a5bac9; height: 25px; }
        HorizontalLayout { spacing: 24px;
            Rectangle { background: #041b28; border-width: 1px; border-color: #154257; border-radius: 8px;
                if root.reference == "": VerticalLayout { padding: 28px; spacing: 18px;
                    Text { text: "Date & Time"; color: white; font-size: 24px; height: 35px; }
                    Text { text: "DATE  ·  YYYY-MM-DD"; color: #a5bac9; height: 20px; }
                    date := LineEdit { text <=> root.chosen-date; placeholder-text: "YYYY-MM-DD"; height: 46px; edited => { root.changed(); } }
                    HorizontalLayout { spacing: 20px;
                        VerticalLayout { spacing: 12px;
                            Text { text: "START TIME (UTC)"; color: #a5bac9; height: 20px; }
                            start := ComboBox { model: ["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"]; current-index <=> root.chosen-start; selected(value) => { root.changed(); } }
                        }
                        VerticalLayout { spacing: 12px;
                            Text { text: "END TIME (UTC)"; color: #a5bac9; height: 20px; }
                            end := ComboBox { model: ["01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00", "24:00"]; current-index <=> root.chosen-end-index; selected(value) => { root.changed(); } }
                        }
                    }
                    Text { text: "Sessions must end on the same day. 24:00 means midnight at the end of that date."; color: #7897ac; wrap: word-wrap; height: 45px; }
                    Text { text: root.error; color: #ff997b; wrap: word-wrap; height: 45px; }
                    Button { text: "Review booking →"; height: 48px; clicked => { root.review(date.text, start.current-index, end.current-index + 1); } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
            Rectangle { width: 350px; background: #041b28; border-width: 1px; border-color: #154257; border-radius: 8px;
                VerticalLayout { padding: 26px; spacing: 18px;
                    Text { text: "Booking Summary"; color: white; font-size: 24px; height: 36px; }
                    Text { text: root.station; color: white; font-size: 32px; font-weight: 700; height: 45px; }
                    Text { text: "Downtown Branch"; color: #a5bac9; height: 25px; }
                    Text { text: root.rate; color: #ff9a40; font-size: 20px; height: 30px; }
                    Rectangle { height: 1px; background: #154257; }
                    Text { text: root.total == "" ? "Choose your date and time, then review your booking." : root.summary; color: #c4d6e4; wrap: word-wrap; height: 85px; }
                    Text { text: "ESTIMATED TOTAL"; color: #7897ac; height: 20px; }
                    Text { text: root.total == "" ? "—" : root.total; color: #ff9a40; font-size: 35px; font-weight: 700; height: 50px; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Button { text: "Confirm demo booking"; enabled: root.total != ""; height: 44px; clicked => { root.confirm(root.chosen-date, root.chosen-start, root.chosen-end-index + 1); } }
                    Text { text: "Preview only. Availability is not checked for this time slot. No station is reserved and no payment is taken."; color: #7897ac; wrap: word-wrap; height: 65px; }
                }
            }
        }
    }
    if root.reference != "": Confirmation {
        reference: root.reference;
        station: root.station;
        summary: root.summary;
        total: root.total;
        back => { root.back(); }
        dashboard => { root.dashboard(); }
        logout => { root.logout(); }
    }
}
