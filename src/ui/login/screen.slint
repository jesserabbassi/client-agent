import { Theme } from "../shared/design.slint";
import { ScrollView } from "std-widgets.slint";
import { LoginPanel } from "login.slint";
export component LoginScreen inherits Rectangle {
    in property <bool> busy;
    in property <bool> authenticated;
    in property <bool> development-mode;
    in property <bool> connection-problem;
    in property <string> status-text;
    in property <string> message;
    in-out property <string> password;
    in-out property <bool> registering;
    in property <bool> registration-success;
    callback login-requested(string, string, bool);
    callback register-requested(string, string, string, string, string);
    Rectangle { x: root.width * 0.45; width: root.width * 0.55; height: root.height; background: @linear-gradient(120deg, #17252c, #0b1019); }
    for i in 9: Rectangle { x: root.width * 0.05 + i * root.width / 9; width: 1px; height: root.height; background: #122135; opacity: 0.4; }
    Rectangle { x: 0px; y: root.height - 170px; width: root.width; height: 1px; background: #1b3048; }
    ScrollView { width: root.width; height: root.height; viewport-width: max(self.width, 540px); viewport-height: max(self.height, 900px); vertical-scrollbar-policy: ScrollBarPolicy.as-needed; horizontal-scrollbar-policy: ScrollBarPolicy.as-needed; mouse-drag-pan-enabled: true;
    Rectangle { width: max(root.width, 540px); height: max(root.height, 900px); background: transparent;
    Rectangle {
        background: transparent;
        x: (parent.width - self.width) / 2; y: 20px;
        width: min(parent.width - 40px, 1240px); height: parent.height - 60px;
        HorizontalLayout {
            y: 0px; width: parent.width; height: 56px; spacing: 14px;
            Rectangle { width: 42px; height: 42px; border-width: 2px; border-color: Theme.accent; border-radius: 5px;
                Text { text: "N"; color: white; font-size: 28px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
            }
            VerticalLayout { spacing: 3px;
                Text { text: "NINETY"; color: Theme.text; font-size: 25px; font-weight: 800; }
                Text { text: "G A M I N G   H O U S E"; color: #a2b4cc; font-size: 9px; }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text { text: "NINETY  /  " + (root.development-mode ? "DEMO SPACE" : "PLAYER ACCESS"); color: Theme.subtle; font-size: 11px; vertical-alignment: center; }
        }
        HorizontalLayout {
            y: max(80px, (parent.height - 720px) / 2); width: parent.width; height: 720px;
            spacing: root.width >= 1050px ? 60px : 0px; alignment: center;
            if root.width >= 1050px: Rectangle { width: parent.width - 550px; background: transparent;
                VerticalLayout {
                    alignment: center; spacing: 20px;
                    Text { text: "THIS IS YOUR ARENA."; color: Theme.cyan; font-size: 12px; height: 24px; }
                    Text { text: "Play."; color: Theme.text; font-size: 62px; font-weight: 900; height: 68px; }
                    Text { text: "Compete."; color: Theme.accent; font-size: 62px; font-weight: 900; height: 68px; }
                    Text { text: "Belong."; color: Theme.cyan; font-size: 62px; font-weight: 900; height: 68px; }
                    Rectangle { width: 54px; height: 3px; background: Theme.accent; }
                    Text { text: "Great games. Good company.\nA place to make your next move."; color: Theme.muted; font-size: 16px; height: 55px; }
                    Rectangle { height: 24px; background: transparent; }
                    Rectangle { width: 225px; height: 74px; background: Theme.surface; border-width: 1px; border-color: Theme.border; border-radius: 10px;
                        VerticalLayout { padding: 14px; spacing: 5px;
                            Text { text: "YOUR GAMING SPACE"; color: Theme.muted; font-size: 10px; }
                            Text { text: "Make it yours."; color: Theme.text; font-size: 24px; font-weight: 700; }
                        }
                    }
                }
            }
            LoginPanel { width: min(490px, parent.width); height: 720px; busy: root.busy; authenticated: root.authenticated; connection-problem: root.connection-problem; status-text: root.status-text; message: root.message; password <=> root.password; registering <=> root.registering; registration-success: root.registration-success; login-requested(u, p, r) => { root.login-requested(u, p, r); } register-requested(f, l, e, p, c) => { root.register-requested(f, l, e, p, c); } }
        }
        HorizontalLayout { y: parent.height - 24px; width: parent.width; height: 24px;
            Text { text: "ESPORTS   /   COMMUNITY   /   PREMIUM EXPERIENCE"; color: Theme.subtle; font-size: 10px; }
            Text { text: "Client Agent v0.1.0"; color: Theme.subtle; font-size: 11px; horizontal-alignment: right; }
        }
    }
    }
    }
}
