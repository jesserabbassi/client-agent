import { Theme, ActionButton } from "../shared/design.slint";
import { CheckBox } from "std-widgets.slint";
import { InputField } from "input-field.slint";
import { PrimaryButton } from "primary-button.slint";
export component LoginPanel inherits Rectangle {
    in-out property <bool> registering: false;
    in property <bool> registration-success: false;
    in property <bool> busy;
    in property <bool> authenticated;
    in property <bool> connection-problem;
    in property <string> status-text;
    in property <string> message;
    in-out property <string> password;
    private property <string> first-name;
    private property <string> last-name;
    private property <string> confirmation;
    private property <bool> remember-me: false;
    callback login-requested(string, string, bool);
    callback register-requested(string, string, string, string, string);
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 16px;
    Rectangle { x: 32px; y: 0px; width: 68px; height: 3px; background: Theme.accent; }
    VerticalLayout {
        padding: root.registering ? 28px : 36px;
        spacing: root.registering ? 9px : 14px;
        Text { text: "YOUR NEXT GREAT SESSION"; color: Theme.cyan; font-size: 11px; font-weight: 600; height: 18px; }
        HorizontalLayout {
            spacing: 8px; height: 38px;
            Text { horizontal-stretch: 0; text: root.registering ? "Join" : "Welcome"; color: Theme.text; font-size: 30px; font-weight: 800; }
            Text { horizontal-stretch: 0; text: root.registering ? "Ninety." : "back."; color: Theme.accent; font-size: 30px; font-weight: 800; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
        }
        Text { text: root.registering ? "Create an account to get started" : "Sign in to start your gaming session"; color: Theme.muted; font-size: 15px; height: 24px; }
        if root.registering: HorizontalLayout {
            spacing: 12px;
            first-name-field := InputField { label: "FIRST NAME"; placeholder: "First name"; value <=> root.first-name; active: !root.busy; accepted => { last-name-field.focus(); } }
            last-name-field := InputField { label: "LAST NAME"; placeholder: "Last name"; value <=> root.last-name; active: !root.busy; accepted => { username.focus(); } }
        }
        username := InputField { label: "EMAIL"; placeholder: "Enter your email"; active: !root.busy && !root.authenticated; accepted => { password-field.focus(); } }
        password-field := InputField { label: "PASSWORD"; placeholder: "Enter your password"; secret: true; value <=> root.password; active: !root.busy && !root.authenticated; accepted => { if !root.registering { root.login-requested(username.value, root.password, root.remember-me); } } }
        if root.registering: confirm-field := InputField { label: "CONFIRM PASSWORD"; placeholder: "Confirm your password"; secret: true; value <=> root.confirmation; active: !root.busy; accepted => { root.register-requested(root.first-name, root.last-name, username.value, root.password, root.confirmation); } }
        if !root.registering: remember := CheckBox { text: "Remember me"; checked <=> root.remember-me; enabled: !root.busy && !root.authenticated; height: 28px; }
        PrimaryButton {
            label: root.busy ? (root.registering ? "CREATING ACCOUNT…" : "SIGNING IN…") : root.registering ? "Create account  →" : root.authenticated ? "AUTHENTICATED  ✓" : "Let’s play   →";
            active: !root.busy && !root.authenticated;
            clicked => { if root.registering { root.register-requested(root.first-name, root.last-name, username.value, root.password, root.confirmation); } else { root.login-requested(username.value, root.password, root.remember-me); } }
        }
        ActionButton { text: root.registering ? "Already have an account? Sign in" : "New here? Create an account"; enabled: !root.busy; clicked => { root.registering = !root.registering; root.password = ""; root.confirmation = ""; } }
        Text { text: root.message; color: root.authenticated || root.registration-success ? #21dfb0 : root.busy ? Theme.muted : #ff9b80; font-size: 13px; wrap: word-wrap; height: 38px; }
        Rectangle { height: 1px; background: #25384e; }
        HorizontalLayout {
            spacing: 9px; height: 28px;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.connection-problem ? #ff633c : root.busy ? #e5b15c : #15dab0; }
            Text { text: root.status-text; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
        }
    }
}
