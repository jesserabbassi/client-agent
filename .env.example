# Base server URL (API endpoints & SignalR hubs derived in code)
NINETY_BASE_URL=http://127.0.0.1:5268
NINETY_ALLOW_INVALID_TLS=false

# Game executables or macOS .app bundles. Paths must be absolute.
# Counter-Strike 2 and Dota 2 use Steam automatically when these are unset.
# NINETY_GAME_CS2=/path/to/game
# NINETY_GAME_VALORANT=/path/to/game
# NINETY_GAME_LOL=/path/to/game
# NINETY_GAME_DOTA2=/path/to/game
# NINETY_GAME_FC24=/path/to/game
# NINETY_GAME_ROCKET_LEAGUE=/path/to/game
# Optional launcher arguments as a JSON array, for example:
# NINETY_GAME_VALORANT_ARGS=["--launch-product=valorant","--launch-patchline=live"]

# Telemetry / Agent Settings
NINETY_AGENT_ID=customer-pc-001
NINETY_TELEMETRY_INTERVAL_MS=2000
NINETY_TELEMETRY_MAX_PROCESSES=128
NINETY_TELEMETRY_ENABLED=true
NINETY_TELEMETRY_HUB_URL=
NINETY_STATION_ID=
NINETY_TELEMETRY_TOKEN_FILE=
