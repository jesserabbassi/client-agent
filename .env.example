# Base server URL (API endpoints & SignalR hubs derived in code)
NINETY_BASE_URL=https://api.example.com
# Local HTTPS only, when the backend uses an untrusted development certificate.
# NINETY_ALLOW_INVALID_TLS=false

# Authentication endpoints (override only when backend routes differ)
NINETY_AUTH_REGISTER_PATH=/api/Auth/register
NINETY_AUTH_LOGIN_PATH=/api/Auth/login
NINETY_AUTH_VERIFY_OTP_PATH=/api/Auth/verify-otp
NINETY_AUTH_REFRESH_PATH=/api/Auth/refresh
NINETY_AUTH_LOGOUT_PATH=/api/Auth/logout
NINETY_AUTH_PROFILE_PATH=/api/Auth/profile
NINETY_AUTH_CHANGE_PASSWORD_PATH=/api/Auth/change-password

# Telemetry / Agent Settings
NINETY_TELEMETRY_ENABLED=false
NINETY_AGENT_ID=customer-pc-001
NINETY_TELEMETRY_INTERVAL_MS=2000
NINETY_TELEMETRY_MAX_PROCESSES=128
